# ============================================================
# Leaf Solar Mailer - Environment Variables
# Copy to .env.local for local development, or set in Vercel.
# ============================================================

# Public URL of the deployed app (used by Capacitor APK + tracking links).
# The APK loads the app from this URL. Default = the branded domain
# https://mailer.leafsolar.ng — same Vercel deployment as
# leafsolar-mailer.vercel.app, but reachable from networks that can't route
# to *.vercel.app (common on some Nigerian ISPs/mobile networks).
APP_URL=https://mailer.leafsolar.ng

# Storage path for the JSON database.
# Local:   ./data/leafsolar-data.json
# Vercel:  /tmp/leafsolar-data.json  (ephemeral scratch; durable data lives
#          in Vercel KV — see KV_* below)
DATABASE_PATH=./data/leafsolar-data.json

# ---- SMTP (optional; can also be configured in-app under Settings) ----
# If set, these override the in-app SMTP settings and persist across
# Vercel cold starts.
SMTP_HOST=mail.leafsolar.ng
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@leafsolar.ng
SMTP_PASS=your-mailbox-password
SMTP_FROM_NAME=Leaf Solar
SMTP_FROM_EMAIL=info@leafsolar.ng

# ---- Durable storage on Vercel (pick ONE — or both, they mirror together) ----
#
# NOTE: "Vercel KV" no longer exists (shut down Dec 2024). The app supports
# two marketplace-free options below; either makes data survive cold starts.
#
# Option A) Supabase Postgres (easiest — no Vercel marketplace needed):
#   1. Create a free project at https://supabase.com
#   2. In the SQL Editor run:
#        create table if not exists app_state (
#          id text primary key,
#          payload jsonb,
#          updated_at timestamptz default now()
#        );
#   3. Copy from Project Settings -> API:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key
#
# Option B) Upstash Redis (the successor to Vercel KV):
#   Create a Redis database at https://upstash.com (or Vercel Marketplace ->
#   "Upstash Redis"). The app auto-detects BOTH naming conventions — use
#   whichever your integration injected (Vercel's integration usually adds
#   KV_REST_API_URL/TOKEN; Upstash's own naming is UPSTASH_REDIS_REST_URL/TOKEN):
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-rest-token
# KV_REST_API_URL=https://your-db.upstash.io
# KV_REST_API_TOKEN=your-rest-token

# ---- Scheduler / cron (optional) ----
# Vercel cron calls /api/scheduler automatically (see vercel.json; frequent
# schedules need a paid plan — on Hobby use the in-app poller or call this
# endpoint externally with the bearer token below).
CRON_SECRET=change-me-to-a-long-random-string
