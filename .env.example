# ============================================================
# Leaf Solar Mailer - Environment Variables
# Copy this file to .env.local and fill in your values.
# ============================================================

# Public URL of the deployed app (used by Capacitor APK to
# connect to your live backend).
APP_URL=https://leafsolar-mailer.vercel.app

# Where the SQLite database file is stored.
# On Vercel/ephemeral filesystems use /tmp; on a VPS use a
# persistent path like ./data/leafsolar.db
DATABASE_PATH=./data/leafsolar.db

# Node environment
NODE_ENV=production
