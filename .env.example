# ============================================================
# Leaf Solar Mailer - Environment Variables
# Copy to .env.local for local development, or set in Vercel.
# ============================================================

# Public URL of the deployed app (used by Capacitor APK + tracking links).
APP_URL=https://mailer.leafsolar.ng

# Storage path for the JSON database.
# Local:   ./data/leafsolar-data.json
# Vercel:  /tmp/leafsolar-data.json  (ephemeral scratch; durable data lives
#          in Vercel KV — see KV_* below)
DATABASE_PATH=./data/leafsolar-data.json

# ---- SMTP (optional; can also be configured in-app under Settings) ----
# If set, these override the in-app SMTP settings and persist across
# Vercel cold starts.
SMTP_HOST=mail.leafsolar.ng
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@leafsolar.ng
SMTP_PASS=your-mailbox-password
SMTP_FROM_NAME=Leaf Solar
SMTP_FROM_EMAIL=info@leafsolar.ng

# ---- Vercel KV (durable storage on Vercel - RECOMMENDED) ----
# Create it: Vercel Dashboard -> Storage -> Create Database -> KV (Upstash).
# The app mirrors the whole JSON store to a single KV key (leafsolar:data),
# so contacts, campaigns, settings etc. survive serverless cold starts.
# KV_REST_API_URL=https://your-db.upstash.io
# KV_REST_API_TOKEN=your-rest-token

# ---- Scheduler / cron (optional) ----
# Vercel cron calls /api/scheduler automatically (see vercel.json; frequent
# schedules need a paid plan — on Hobby use the in-app poller or call this
# endpoint externally with the bearer token below).
CRON_SECRET=change-me-to-a-long-random-string
